[
  {
    "id": "aws_keys",
    "category": "aws_keys",
    "description": "AWS access key IDs",
    "regex": "(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}",
    "flags": ""
  },
  {
    "id": "aws_secrets",
    "category": "aws_secrets",
    "description": "AWS secret access keys following a key-name assignment",
    "regex": "(aws_secret_access_key|aws_secret|secret_access_key)\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})[\"']?",
    "flags": "i"
  },
  {
    "id": "aws_accounts",
    "category": "aws_accounts",
    "description": "AWS 12-digit account IDs in an assignment context",
    "regex": "(aws_account_id|account[_-]?id)\\s*[:=]\\s*[\"']?(\\d{12})[\"']?",
    "flags": "i"
  },
  {
    "id": "aws_arns",
    "category": "aws_arns",
    "description": "Full AWS ARNs across partitions and services",
    "regex": "arn:(aws|aws-cn|aws-us-gov):[A-Za-z0-9-]+:[a-z0-9-]*:\\d{12}:[A-Za-z0-9-_/:.*]+",
    "flags": ""
  },
  {
    "id": "db_strings",
    "category": "db_strings",
    "description": "Database connection strings with embedded credentials",
    "regex": "(postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|mssql|sqlserver)://[^:/\\s]+:[^@/\\s]+@[^/\\s]+",
    "flags": "i"
  },
  {
    "id": "jwt_tokens",
    "category": "jwt_tokens",
    "description": "Three-part base64url JSON Web Tokens",
    "regex": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": ""
  },
  {
    "id": "npm_tokens",
    "category": "npm_tokens",
    "description": "NPM registry tokens and legacy _authToken lines",
    "regex": "(npm_[A-Za-z0-9]{36})|(_authToken\\s*=\\s*[A-Za-z0-9._-]+)",
    "flags": ""
  },
  {
    "id": "private_ips",
    "category": "private_ips",
    "description": "RFC 1918 private IPv4 addresses",
    "regex": "\\b(10\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3})\\b",
    "flags": ""
  }
]
